                    Return (GPRW (0x6D, 0x04))
                }

                Name (BTDL, 0x32)
                Name (RSTT, Zero)
                Name (PRRS, Zero)
                OperationRegion (CBTR, SystemMemory, BASE (), 0x0100)
                Field (CBTR, WordAcc, NoLock, Preserve)
                {
                    VDID,   32, 
                    Offset (0x44), 
                        ,   28, 
