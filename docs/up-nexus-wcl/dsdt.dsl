                        Name (_UID, "VGPO")  // _UID: Unique ID
                        Name (_DDN, "Intel UsbGpio Device")  // _DDN: DOS Device Name
                        Method (_HID, 0, NotSerialized)  // _HID: Hardware ID
                        {
                            Return ("INTC10E2")
                        }

