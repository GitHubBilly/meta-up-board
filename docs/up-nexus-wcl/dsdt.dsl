            CreateWordField (BUF0, \_SB.PC00._Y12._LEN, PBLN)  // _LEN: Length
            CreateWordField (BUF0, \_SB.PC00._Y12._MIN, PBMN)  // _MIN: Minimum Base Address
            Local0 = GPCL ()
            PBMX = ((Local0 >> 0x14) - 0x02)
            PBLN = ((Local0 >> 0x14) - One)
            If (CondRefOf (\MSUB))
            {
                If ((PBMX != MSUB))
                {
                    PBMX = MSUB /* \MSUB */
                    PBLN = (MSUB + One)
                    ADBG (Concatenate ("Update PciHost visible Bus numbers to ", ToHexString (PBMX)))
                    ADBG (Concatenate ("Update PciHost visible Bus length ", ToHexString (PBLN)))
                }
                ElseIf (CondRefOf (\VMDE))
                {
                    If (((VMDE == One) && (PBMX > 0xDF)))
                    {
                        PBMX = 0xDF
                        PBLN = 0xE0
                        ADBG (Concatenate ("VMD is enabled, restricting Bus numbers to ", ToHexString (PBMX)))
                    }
                }
            }

            If (^MC.PM1L)
            {
                CreateDWordField (BUF0, \_SB.PC00._Y13._LEN, C0LN)  // _LEN: Length
