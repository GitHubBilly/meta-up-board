                    Method (_CRS, 0, Serialized)  // _CRS: Current Resource Settings
                    {
                        Local1 = G_IN (LDGP, One, One, One, Zero, Zero)
                        Local2 = G_IO (LRGP, Zero, Zero, Zero, Zero, 0x02)
                        ConcatenateResTemplate (Local1, Local2, Local0)
                        Name (VGB1, ResourceTemplate ()
                        {
                            GpioIo (Exclusive, PullUp, 0x0000, 0x0000, IoRestrictionOutputOnly,
                                "\\_SB.PC00.XHCI.RHUB.HS03.VGPO", 0x00, ResourceConsumer, ,
                                )
                                {   // Pin list
                                    0x0000
                                }
                            GpioIo (Exclusive, PullUp, 0x0000, 0x0000, IoRestrictionInputOnly,
                                "\\_SB.PC00.XHCI.RHUB.HS03.VGPO", 0x00, ResourceConsumer, ,
                                )
                                {   // Pin list
                                    0x0007
                                }
                        })
                        Name (IIC1, ResourceTemplate ()
                        {
                            I2cSerialBusV2 (0x0000, ControllerInitiated, 0x00400000,
                                AddressingMode7Bit, "\\_SB.PC00.XHCI.RHUB.HS03.VIC0",
                                0x00, ResourceConsumer, _Y5D, Exclusive,
                                )
                        })
