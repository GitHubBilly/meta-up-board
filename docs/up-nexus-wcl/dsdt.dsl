                REGS [One] = DLH /* \_SB_.UPS3.DLH_ */
                LCR = Local1
                REGS [0x02] = FCR /* \_SB_.UPS3.FCR_ */
                REGS [0x03] = Local1
                REGS [0x04] = MCR /* \_SB_.UPS3.MCR_ */
                REGS [0x05] = PCLK /* \_SB_.UPS3.PCLK */
                If (((DerefOf (REGS [0x05]) != Zero) && (
                    DerefOf (REGS [0x05]) != 0xFFFFFFFF)))
                {
