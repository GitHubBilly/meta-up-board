                        RL23 ()
                        Sleep (0x64)
                        VDRA (RSPT, RSPI, One)
                        Sleep (0x64)
                        VDRA (RSPT, RSPI, Zero)
                        RLA ()
                        Sleep (0x64)
                    }
                }

