                                            )
                                    })
                                    CreateWordField (VCCT, \_SB.PC00.XHCI.RHUB.HS03.VIC1.IIT2._CRS._Y5F._ADR, DAD3)  // _ADR: Address
                                    DAD3 = 0x10
